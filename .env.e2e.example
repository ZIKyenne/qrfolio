# Variables pour la QA navigateur Playwright (B11) — NOMS uniquement, aucune valeur réelle.
# Copier en .env.e2e (ignoré par Git) et renseigner avec un compte de TEST dédié (jamais prod).

# Port du serveur Next lancé par Playwright (défaut 3100)
E2E_PORT=3100

# Compte de TEST Supabase (requis UNIQUEMENT pour les parcours authentifiés :
# création de page, Builder, sauvegarde, publication, soumission de formulaires).
# Sans ces variables, seuls les tests PUBLICS (smoke, harness des blocs shared,
# redirection d'auth) s'exécutent ; les parcours authentifiés sont ignorés avec raison.
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=

# Base d'URL publique éventuelle (défaut http://localhost:3100)
E2E_BASE_URL=

# Test du formulaire contact : URL d'une page PUBLIÉE de test contenant un bloc contact_form.
# Sans cette variable, le test de formulaire est ignoré. Ne jamais pointer une page de production.
E2E_CONTACT_PAGE_URL=

# Autoriser la SOUMISSION réelle du formulaire (=1) — crée un lead + emails (compte de test only).
# Par défaut vide : seuls le rendu et la validation sont testés (aucune donnée écrite).
E2E_ALLOW_LEAD_SUBMIT=
